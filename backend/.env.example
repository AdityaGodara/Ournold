# --- Firebase Admin (paste the whole service-account JSON on ONE line) ---
FIREBASE_CREDENTIALS=
# or a path to the JSON file for local dev:
FIREBASE_CRED_PATH=

# --- Encrypts users' Gemini keys at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=

# --- Optional ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=            # only used for the public random-fact endpoint
SPOONACULAR_API_KEY=       # manual food macro lookup
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ournold.vercel.app
AI_RATE_LIMIT=30
AI_RATE_WINDOW_SEC=60
